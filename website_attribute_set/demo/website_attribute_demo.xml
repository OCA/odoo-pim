<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Attribute Group for E-Commerce Demo -->
    <record id="demo_ecom_attribute_group" model="attribute.group">
        <field name="name">Website Attribute Set Demo Group</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="sequence">10</field>
    </record>

    <!-- Attribute Set for E-Commerce Demo Products -->
    <record id="demo_ecom_attribute_set" model="attribute.set">
        <field name="name">Website Attribute Set Demo</field>
        <field name="model_id" ref="product.model_product_template" />
    </record>

    <!-- Boolean Attribute: Linux Compatible -->
    <record id="demo_attr_linux_compatible" model="attribute.attribute">
        <field name="nature">custom</field>
        <field name="field_description">Demo Linux Compatible</field>
        <field name="name">x_was_demo_linux</field>
        <field name="attribute_type">boolean</field>
        <field name="attribute_group_id" ref="demo_ecom_attribute_group" />
        <field name="attribute_set_ids" eval="[(4, ref('demo_ecom_attribute_set'))]" />
        <field name="model_id" ref="product.model_product_template" />
        <field name="e_com_visibility" eval="True" />
        <field name="e_com_searchable" eval="True" />
    </record>

    <!-- Char Attribute: Brand -->
    <record id="demo_attr_brand" model="attribute.attribute">
        <field name="nature">custom</field>
        <field name="field_description">Demo Brand</field>
        <field name="name">x_was_demo_brand</field>
        <field name="attribute_type">char</field>
        <field name="attribute_group_id" ref="demo_ecom_attribute_group" />
        <field name="attribute_set_ids" eval="[(4, ref('demo_ecom_attribute_set'))]" />
        <field name="model_id" ref="product.model_product_template" />
        <field name="e_com_visibility" eval="True" />
        <field name="e_com_searchable" eval="True" />
    </record>

    <!-- Select Attribute: Category Type (with multi-select and count badges) -->
    <record id="demo_attr_category_type" model="attribute.attribute">
        <field name="nature">custom</field>
        <field name="field_description">Demo Category Type</field>
        <field name="name">x_was_demo_cattype</field>
        <field name="attribute_type">select</field>
        <field name="attribute_group_id" ref="demo_ecom_attribute_group" />
        <field name="attribute_set_ids" eval="[(4, ref('demo_ecom_attribute_set'))]" />
        <field name="model_id" ref="product.model_product_template" />
        <field name="e_com_visibility" eval="True" />
        <field name="e_com_searchable" eval="True" />
        <field name="e_com_filter" eval="True" />
        <field name="e_com_multi_select" eval="True" />
        <field name="e_com_show_count" eval="True" />
    </record>

    <!-- Options for Category Type Select -->
    <record id="demo_option_laptop" model="attribute.option">
        <field name="name">Laptop</field>
        <field name="attribute_id" ref="demo_attr_category_type" />
    </record>
    <record id="demo_option_desktop" model="attribute.option">
        <field name="name">Desktop</field>
        <field name="attribute_id" ref="demo_attr_category_type" />
    </record>
    <record id="demo_option_accessory" model="attribute.option">
        <field name="name">Accessory</field>
        <field name="attribute_id" ref="demo_attr_category_type" />
    </record>

    <!-- Integer Attribute: Warranty Years (with range filter enabled) -->
    <record id="demo_attr_warranty" model="attribute.attribute">
        <field name="nature">custom</field>
        <field name="field_description">Demo Warranty (Years)</field>
        <field name="name">x_was_demo_warranty</field>
        <field name="attribute_type">integer</field>
        <field name="attribute_group_id" ref="demo_ecom_attribute_group" />
        <field name="attribute_set_ids" eval="[(4, ref('demo_ecom_attribute_set'))]" />
        <field name="model_id" ref="product.model_product_template" />
        <field name="e_com_visibility" eval="True" />
        <field name="e_com_searchable" eval="True" />
        <field name="e_com_filter" eval="True" />
        <field name="e_com_range_filter" eval="True" />
    </record>

    <!-- Text Attribute: Detailed Description (visible but NOT searchable for performance) -->
    <record id="demo_attr_detailed_desc" model="attribute.attribute">
        <field name="nature">custom</field>
        <field name="field_description">Demo Description</field>
        <field name="name">x_was_demo_desc</field>
        <field name="attribute_type">text</field>
        <field name="attribute_group_id" ref="demo_ecom_attribute_group" />
        <field name="attribute_set_ids" eval="[(4, ref('demo_ecom_attribute_set'))]" />
        <field name="model_id" ref="product.model_product_template" />
        <field name="e_com_visibility" eval="True" />
        <field name="e_com_searchable" eval="False" />
    </record>

    <!-- Demo Product 1: Linux Laptop -->
    <record id="demo_product_linux_laptop" model="product.template">
        <field name="name">Demo Linux Developer Laptop</field>
        <field name="type">consu</field>
        <field name="list_price">1299.00</field>
        <field name="is_published" eval="True" />
        <field name="attribute_set_id" ref="demo_ecom_attribute_set" />
        <field name="x_was_demo_linux" eval="True" />
        <field name="x_was_demo_brand">TechPro</field>
        <field name="x_was_demo_cattype" ref="demo_option_laptop" />
        <field name="x_was_demo_warranty">3</field>
        <field
            name="x_was_demo_desc"
        >High-performance laptop pre-installed with Ubuntu Linux. Perfect for developers and open-source enthusiasts. Features 16GB RAM and 512GB NVMe SSD.</field>
    </record>

    <!-- Demo Product 2: Windows Desktop -->
    <record id="demo_product_windows_desktop" model="product.template">
        <field name="name">Demo Office Desktop Computer</field>
        <field name="type">consu</field>
        <field name="list_price">899.00</field>
        <field name="is_published" eval="True" />
        <field name="attribute_set_id" ref="demo_ecom_attribute_set" />
        <field name="x_was_demo_linux" eval="False" />
        <field name="x_was_demo_brand">OfficeMate</field>
        <field name="x_was_demo_cattype" ref="demo_option_desktop" />
        <field name="x_was_demo_warranty">2</field>
        <field
            name="x_was_demo_desc"
        >Standard office desktop computer. Pre-configured for business applications. Includes 8GB RAM and 256GB SSD.</field>
    </record>

    <!-- Demo Product 3: Linux Compatible Keyboard -->
    <record id="demo_product_keyboard" model="product.template">
        <field name="name">Demo Mechanical Keyboard</field>
        <field name="type">consu</field>
        <field name="list_price">149.00</field>
        <field name="is_published" eval="True" />
        <field name="attribute_set_id" ref="demo_ecom_attribute_set" />
        <field name="x_was_demo_linux" eval="True" />
        <field name="x_was_demo_brand">KeyMaster</field>
        <field name="x_was_demo_cattype" ref="demo_option_accessory" />
        <field name="x_was_demo_warranty">1</field>
        <field
            name="x_was_demo_desc"
        >Premium mechanical keyboard with Cherry MX switches. Full Linux compatibility with customizable keys.</field>
    </record>

    <!-- Demo Product 4: Another Linux Laptop (different brand) -->
    <record id="demo_product_linux_laptop_2" model="product.template">
        <field name="name">Demo Budget Linux Laptop</field>
        <field name="type">consu</field>
        <field name="list_price">599.00</field>
        <field name="is_published" eval="True" />
        <field name="attribute_set_id" ref="demo_ecom_attribute_set" />
        <field name="x_was_demo_linux" eval="True" />
        <field name="x_was_demo_brand">ValueTech</field>
        <field name="x_was_demo_cattype" ref="demo_option_laptop" />
        <field name="x_was_demo_warranty">1</field>
        <field
            name="x_was_demo_desc"
        >Affordable laptop that works great with Linux distributions. 4GB RAM, 128GB SSD. Perfect for learning Linux.</field>
    </record>
</odoo>
