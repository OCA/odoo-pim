<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Template temporarily disabled due to Odoo 19 xpath compatibility issue -->
    <!-- The original xpath //table[@id='o_comparelist_table'] does not exist in Odoo 19 -->

    <template
        id="custom_specifications_table"
        inherit_id="website_sale_comparison.specifications_table"
        name="Specifications Table"
    >
        <xpath expr="//table" position="after">
            <table t-attf-class="table {{is_accordion and 'table-sm mb-0'}}">
                <tr t-foreach="additional_attributes" t-as="attribute_dict">
                    <t t-set="attribute" t-value="attribute_dict.get('attribute')" />
                    <t
                        t-set="attribute_values"
                        t-value="attribute_dict.get('attribute_values')"
                    />
                    <t t-if="attribute_values">
                        <t
                            t-set="hide_border_bottom_classes"
                            t-value="'border-bottom-0' if attribute_last and is_accordion else ''"
                        />
                        <td t-attf-class="w-25 {{hide_border_bottom_classes}} ps-0 ">
                            <span t-field="attribute.field_description" />
                        </td>
                        <td
                            t-attf-class="w-75 {{hide_border_bottom_classes}} pe-0 text-muted text-end"
                        >
                            <t
                                t-if="attribute.attribute_type in ['select', 'multiselect']"
                            >
                                <t t-foreach="attribute_values" t-as="value">
                                    <span t-out="value.name" />
                                    <t t-if="not value_last">, </t>
                                </t>
                            </t>
                            <t
                                t-if="attribute.attribute_type in ['boolean', 'char', 'text', 'date', 'datetime', 'integer', 'float']"
                            >
                                <t t-if="attribute.attribute_type == 'boolean'">
                                    <span t-out="'Yes'" />
                                </t>
                                <t t-elif="attribute.attribute_type == 'integer'">
                                    <span
                                        t-out="attribute_values"
                                        t-options='{"widget": "integer"}'
                                    />
                                </t>
                                <t t-elif="attribute.attribute_type == 'float'">
                                    <span t-out="attribute_values" />
                                </t>
                                <t t-if="attribute.attribute_type == 'date'">
                                    <span
                                        t-out="attribute_values"
                                        t-options='{"widget": "date"}'
                                    />
                                </t>
                                <t t-if="attribute.attribute_type == 'datetime'">
                                    <t
                                        t-set="tz_value"
                                        t-value="request.env.user.tz or 'UTC'"
                                    />
                                    <span
                                        t-out="attribute_values"
                                        t-options='{"widget": "datetime", "tz_name": tz_value, "format": "short"}'
                                    />
                                </t>
                                <t t-if="attribute.attribute_type in ['char', 'text']">
                                    <span t-out="attribute_values" />
                                </t>
                            </t>
                        </td>
                    </t>
                </tr>
            </table>
        </xpath>
    </template>
</odoo>
