<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="attribute_attribute_form_view" model="ir.ui.view">
        <field name="name">attribute.attribute.form</field>
        <field name="model">attribute.attribute</field>
        <field name="inherit_id" ref="attribute_set.attribute_attribute_form_view" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook" position="before">
                    <separator string="E-Commerce" />
                    <group>
                        <group>
                            <field name="e_com_visibility" />
                        </group>
                        <group invisible="not e_com_visibility">
                            <field
                                name="e_com_filter"
                                readonly="not field_is_searchable and not e_com_filter"
                            />
                            <field name="e_com_specification" />
                            <field name="field_is_searchable" invisible="1" />
                            <field
                                name="e_com_searchable"
                                readonly="not field_is_searchable and not e_com_searchable"
                            />
                            <field
                                name="e_com_range_filter"
                                invisible="attribute_type not in ('integer', 'float')"
                            />
                            <field
                                name="e_com_multi_select"
                                invisible="attribute_type not in ('select', 'multiselect')"
                            />
                            <field name="e_com_show_count" />
                        </group>
                    </group>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
