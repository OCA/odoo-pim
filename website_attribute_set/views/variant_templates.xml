<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="variants" inherit_id="website_sale.variants">
        <xpath expr="//ul" position="after">
            <t
                t-set="additional_specification_attributes"
                t-value="[x for x in (additional_attributes or []) if x['attribute'].e_com_specification and x.get('attribute_values')]"
            />
            <table
                t-if="additional_specification_attributes"
                class="table table-sm table-borderless o_wsale_additional_attributes mt-3"
            >
                <tbody>
                    <t
                        t-foreach="additional_specification_attributes"
                        t-as="attribute_dict"
                    >
                        <t t-set="attribute" t-value="attribute_dict['attribute']" />
                        <t
                            t-set="attribute_values"
                            t-value="attribute_dict['attribute_values']"
                        />
                        <t
                            t-set="attr_type"
                            t-value="attribute.attribute_type or attribute.ttype"
                        />
                        <tr
                            class="o_wsale_additional_attribute"
                            t-att-data-attribute_id="attribute.id"
                        >
                            <td
                                class="text-muted w-50"
                                t-out="attribute.field_description"
                            />
                            <td>
                                <t
                                    t-if="attr_type in ['select', 'multiselect', 'many2one', 'many2many']"
                                    t-out="', '.join(attribute_values.mapped('display_name'))"
                                />
                                <t t-elif="attr_type == 'boolean'">Yes</t>
                                <t
                                    t-elif="attr_type in ['integer', 'float']"
                                    t-out="attribute._format_e_com_number(attribute_values)"
                                />
                                <t
                                    t-elif="attr_type == 'date'"
                                    t-out="attribute_values"
                                    t-options='{"widget": "date"}'
                                />
                                <t
                                    t-elif="attr_type == 'datetime'"
                                    t-out="attribute_values"
                                    t-options='{"widget": "datetime", "tz_name": request.env.user.tz or "UTC", "format": "short"}'
                                />
                                <t t-else="" t-out="attribute_values" />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
