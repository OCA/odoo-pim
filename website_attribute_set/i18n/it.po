#. module: website_attribute_set
#: model:ir.model.fields,help:website_attribute_set.field_attribute_attribute__e_com_range_filter
msgid ""
"For numeric attributes (integer/float), show min/max range inputs\n"
"        instead of individual value selection in the shop filter."
msgstr ""
"Per attributi numerici (interi, decimali), visualizza gli intervalli min/max "
"di inserimento\n"
"        al posto di una selezione di valori singoli nel filtro negozio."

