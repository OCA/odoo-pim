<odoo>
    <record id="product_vector_characteristic_form_view" model="ir.ui.view">
        <field name="model">product.vector.characteristic</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="product" string="Product">
                        <field name="field_id" options="{'no_create': True}" />
                        <field name="model_id" invisible="not field_id" />
                        <field name="value_id_visible" invisible="1" />
                        <field name="field_type" invisible="1" />
                        <field name="value_model" invisible="1" />
                        <field name="selection_field_id" invisible="1" />
                        <field
                            name="value_id"
                            invisible="field_type not in ('many2one', 'many2many')"
                            required="field_type in ('many2one', 'many2many')"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="selection_value_id"
                            invisible="field_type != 'selection'"
                            required="field_type == 'selection'"
                            options="{'no_create': True, 'no_open': True}"
                        />
                    </group>
                    <group name="vector" string="Vector">
                        <field name="weight" />
                        <field name="vector_index" invisible="not id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_vector_characteristic_list_view" model="ir.ui.view">
        <field name="model">product.vector.characteristic</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button
                        name="%(product_field_vectorization_wizard_action)d"
                        string="Vectorize Field"
                        type="action"
                        class="btn-primary"
                        display="always"
                        groups="product.group_product_manager"
                    />
                </header>
                <field name="vector_index" />
                <field name="name" />
                <field name="field_id" />
                <field name="model_id" />
                <field name="weight" />
            </list>
        </field>
    </record>

    <record id="product_vector_characteristic_search_view" model="ir.ui.view">
        <field name="model">product.vector.characteristic</field>
        <field name="arch" type="xml">
            <search>
                <field name="field_id" />
                <group name="groupby">
                    <filter
                        name="group_by_field"
                        string="Field"
                        context="{'group_by': 'field_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="product_vector_characteristic_act_window" model="ir.actions.act_window">
        <field name="name">Product Vector Characteristics</field>
        <field name="res_model">product.vector.characteristic</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="product_vector_characteristic_menu"
        name="Product Vector Characteristics"
        parent="base.menu_custom"
        action="product_vector_characteristic_act_window"
        groups="product.group_product_manager"
    />
</odoo>
