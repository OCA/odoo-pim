<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="ProductCatalogSearchPanel.Custom1"
        t-inherit="ProductCatalogSearchPanel.FiltersGroup"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//li[@t-foreach='[...this.state.sectionOfAttributes.keys()]']"
            position="attributes"
        >
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath
            expr="//li[@t-foreach='[...this.state.sectionOfAttributes.keys()]']"
            position="after"
        >
            <li
                t-foreach="[...values.keys()]"
                t-as="valueId"
                t-key="valueId"
                class="o_search_panel_filter_value list-group-item p-0 mb-1 border-0 cursor-pointer"
                t-att-class="{ 'ps-2' : isChildList }"
            >
                <t t-set="value" t-value="values.get(valueId)" />
                <div class="form-check w-100">
                    <input
                        type="checkbox"
                        t-attf-id="{{ section.id }}_input_{{ valueId }}"
                        t-att-checked="state.active[section.id][valueId]"
                        class="form-check-input"
                        t-on-click="ev => this.toggleFilterValue(section.id, valueId, ev)"
                    />
                    <label
                        class="o_search_panel_label form-check-label d-flex align-items-center justify-content-between w-100 cursor-pointer"
                        t-attf-for="{{ section.id }}_input_{{ valueId }}"
                        t-att-title="(group and group.tooltip) or false"
                    >
                        <span
                            class="o_search_panel_label_title text-truncate"
                            t-esc="value.display_name"
                        />
                        <span
                            t-if="section.enableCounters and value.__count gt 0"
                            class="o_search_panel_counter text-muted mx-2 small"
                            t-esc="value.__count"
                        />
                    </label>
                </div>
            </li>
        </xpath>
    </t>

    <t t-name="ProductCatalogSearchPanel.Attribute.Values">
        <li t-foreach="attr.vals" t-as="val" t-key="val_index">
            <t t-if="Array.isArray(val)">
                <t t-set="value" t-value="val[0]" />
                <t t-set="count" t-value="val[1]" />
            </t>
            <div t-if="value" class="form-check w-100">
                <t t-if="typeof value === 'boolean'">
                    <t t-set="attrValName" t-value="'Yes'" />
                </t>
                <t t-else="">
                    <t t-set="attrValName" t-value="value" />
                </t>
                <t
                    t-set="isDomainInSearch"
                    t-value="state.isDomainInSearch(env.searchModel.facets, attr, value)"
                />
                <input
                    type="checkbox"
                    t-attf-id="{{ value }}_input_{{ attrName }}_val"
                    t-att-checked="isDomainInSearch"
                    class="form-check-input"
                    t-on-click="ev => this.toggleSectionFilterValue2(attr, value, ev)"
                />
                <label
                    class="o_search_panel_label form-check-label d-flex align-items-center justify-content-between w-100 o_cursor_pointer"
                    t-attf-for="{{ value }}_input_{{ attrName }}_val"
                    t-att-title="(group and group.tooltip) or false"
                >
                    <span
                        class="o_search_panel_label_title text-truncate"
                        t-esc="attrValName"
                    />
                    <span
                        class="o_search_panel_counter text-muted mx-2 small"
                        t-esc="count"
                    />
                </label>
            </div>
        </li>
    </t>

    <t
        t-name="ProductCatalogSearchPanel.Custom2"
        t-inherit="web.SearchPanel.Regular"
        t-inherit-mode="primary"
    >
        <xpath expr="//div[hasclass('o_search_panel')]" position="inside">
            <header
                t-if="state.extra_attrs.length > 0"
                class="o_search_panel_section_header pt-4 pb-2 text-uppercase cursor-default"
            >
                <i
                    t-attf-class="fa fa-th-list text-warning o_search_panel_section_icon me-2"
                />
                <b t-esc="'Extra Attributes'" />
            </header>
            <li
                t-foreach="state.extra_attrs"
                t-as="attr"
                t-key="attr.id"
                class="o_search_panel_filter_value list-group-item p-0 mb-1 border-0 o_cursor_pointer"
                t-att-class="{ 'ps-2' : isChildList }"
            >
                <div class="form-check w-100">
                    <t t-set="attrName" t-value="attr.display_name" />
                    <t
                        t-set="isDomainInSearch"
                        t-value="state.isDomainInSearch(env.searchModel.facets, attr, null)"
                    />
                    <input
                        type="checkbox"
                        t-attf-id="{{ attr.id }}_input_{{ attrName }}"
                        t-att-checked="isDomainInSearch"
                        class="form-check-input"
                        t-on-click="ev => this.toggleSectionFilterValue2(attr, null, ev)"
                    />
                    <label
                        class="o_search_panel_label form-check-label d-flex align-items-center justify-content-between w-100 o_cursor_pointer"
                        t-attf-for="{{ attr.id }}_input_{{ attrName }}"
                        t-att-title="(group and group.tooltip) or false"
                    >
                        <span
                            class="o_search_panel_label_title text-truncate"
                            t-esc="attrName"
                        />
                        <span
                            class="o_search_panel_counter text-muted mx-2 small"
                            t-esc="attr.count"
                        />
                    </label>
                    <t t-if="attr.vals">
                        <t t-call="ProductCatalogSearchPanel.Attribute.Values">
                            <t t-set="attr" t-value="attr" />
                            <t t-set="vals" t-value="attr.vals" />
                            <t t-set="attrName" t-value="attr.display_name" />
                        </t>
                    </t>
                </div>
            </li>
        </xpath>
    </t>

    <t t-name="web.SearchPanel.Section.Custom">
        <ul class="list-group d-block o_search_panel_field px-2 px-md-0">
            <li
                t-foreach="state.extra_attrs"
                t-as="attr"
                t-key="attr.id"
                class="o_search_panel_filter_group list-group-item p-0 border-0"
            >
                <t t-set="attrName" t-value="attr.display_name" />
                <header class="o_search_panel_group_header pb-1">
                    <div class="form-check w-100">
                        <input
                            type="checkbox"
                            t-attf-id="{{ attr.id }}_input_{{ attrName }}"
                            t-att-checked="attr.checked"
                            class="form-check-input"
                            t-on-click="ev => this.toggleSectionFilterValue2(attr, null, ev)"
                        />
                        <label
                            t-attf-for="{{ attr.id }}_input_{{ attrName }}"
                            class="o_search_panel_label form-check-label d-flex align-items-center justify-content-between w-100 cursor-pointer"
                            t-att-title="attrName"
                        >
                            <span class="o_search_panel_label_title text-truncate">
                                <t t-esc="attrName" />
                            </span>
                            <span
                                class="o_search_panel_counter text-muted mx-2 small"
                                t-esc="attr.count"
                            />
                        </label>
                        <t t-if="attr.vals">
                            <t t-call="ProductCatalogSearchPanel.Attribute.Values">
                                <t t-set="attr" t-value="attr" />
                                <t t-set="vals" t-value="attr.vals" />
                                <t t-set="attrName" t-value="attr.display_name" />
                            </t>
                        </t>
                    </div>
                </header>
            </li>
        </ul>
    </t>

    <t
        t-name="web.SearchPanel.Small.Custom"
        t-inherit="web.SearchPanel.Small"
        t-inherit-mode="primary"
    >
        <xpath expr="//Dropdown" position="after">
            <Dropdown t-if="state.extra_attrs.length > 0" menuClass="'my-2 mx-1'">
                <span class="btn btn-secondary my-2 mx-1 o-dropdown-caret">
                    <i
                        t-attf-class="fa fa-th-list o_search_panel_section_icon me-2 text-warning"
                    />
                    <b class="pe-2" t-esc="'Extra Attributes'" />
                </span>
                <t t-set-slot="content">
                    <div class="o_search_panel_section">
                        <t t-call="web.SearchPanel.Section.Custom" />
                    </div>
                </t>
            </Dropdown>
        </xpath>
    </t>

    <t t-name="web.SearchPanel.Custom">
        <t t-if="env.isSmall">
            <t t-call="web.SearchPanel.Small.Custom" />
        </t>
        <t t-else="">
            <t
                t-if="state.sidebarExpanded"
                t-call="ProductCatalogSearchPanel.Custom2"
            />
            <t t-else="" t-call="web.SearchPanel.Sidebar" />
        </t>
    </t>
</templates>
